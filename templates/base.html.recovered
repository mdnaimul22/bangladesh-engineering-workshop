<!DOCTYPE html>
<html lang="bn">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}বাংলাদেশ ইঞ্জিনিয়ারিং ওয়ার্কশপ{% endblock %}</title>
    <link rel="icon" type="image/svg+xml" href="{{ url_for('static', filename='img/logo.svg') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='buttons.css') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link
        href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;500;600;700&family=Inter:wght@300;400;700&display=swap"
        rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    {% block extra_css %}{% endblock %}
</head>

<body>
    <!-- Overlay for mobile/sidebar -->
    <div class="overlay" id="overlay"></div>

    <nav class="navbar">
        <div class="container nav-container">
            <div class="nav-left">
                <button class="menu-toggle" id="menuToggle">
                    <span class="material-icons">menu</span>
                </button>
                <a href="{{ url_for('core.index') }}" class="logo">
                    <img src="{{ url_for('static', filename='img/logo.svg') }}" alt="BW Logo"
                        style="height: 85px; width: auto;">
                    বাংলাদেশ ইঞ্জিনিয়ারিং ওয়ার্কসপ
                </a>
            </div>

            <div class="nav-links">
                <a href="{{ url_for('core.index') }}" class="nav-link">
                    <span class="material-icons v-middle">home</span> {{ _('Home') }}
                </a>

                <div class="dropdown">
                    <a href="javascript:void(0)" class="nav-link">
                        <span class="material-icons v-middle">business_center</span> {{ _('ERP') }}
                        <span class="material-icons v-middle" style="font-size: 18px;">expand_more</span>
                    </a>
                    <div class="dropdown-content">
                        <a href="{{ url_for('buyers.buyer_list') }}">
                            <span class="material-icons v-middle" style="font-size: 18px;">people</span> {{
                            _('Buyers') }}
                        </a>
                        <a href="{{ url_for('purchases.purchase_list') }}">
                            <span class="material-icons v-middle" style="font-size: 18px;">shopping_cart</span> {{
                            _('Purchases') }}
                        </a>
                        <a href="{{ url_for('inventory.inventory_list') }}">
                            <span class="material-icons v-middle" style="font-size: 18px;">inventory_2</span> {{
                            _('Inventory') }}
                        </a>
                        <a href="{{ url_for('work_orders.work_order_list') }}">
                            <span class="material-icons v-middle" style="font-size: 18px;">assignment</span> {{ _('Work
                            Orders') }}

                        </a>
                        <a href="{{ url_for('sales.sale_list') }}">
                            <span class="material-icons v-middle" style="font-size: 18px;">receipt_long</span> {{
                            _('Sales') }}
                        </a>
                    </div>
                </div>

                <a href="{{ url_for('shops.shop_list') }}" class="nav-link">
                    <span class="material-icons v-middle">storefront</span> {{ _('All Shops') }}
                </a>
                <a href="{{ url_for('shops.new_shop') }}" class="btn btn-navy">
                    <span class="material-icons">add_circle</span>
                    {{ _('New Shop') }}
                </a>
                <div class="lang-toggle">
                    <a href="{{ url_for('core.set_language', lang_code='bn') }}"
                        class="nav-link {% if session.get('lang', 'bn') == 'bn' %}active-lang{% endif %}">বাংলা</a>
                    <span class="divider">|</span>
                    <a href="{{ url_for('core.set_language', lang_code='en') }}"
                        class="nav-link {% if session.get('lang') == 'en' %}active-lang{% endif %}">EN</a>
                </div>
            </div>
        </div>
        <div class="theme-toggle-container">
            <button id="themeToggle" class="theme-btn" title="Toggle Theme">
                <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="5"></circle>
                    <line x1="12" y1="1" x2="12" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="23"></line>
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                    <line x1="1" y1="12" x2="3" y2="12"></line>
                    <line x1="21" y1="12" x2="23" y2="12"></line>
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                </svg>
                <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                </svg>
            </button>
        </div>
    </nav>

    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <h3>{{ _('Categories') }}</h3>
        </div>
        <div class="sidebar-content">
            <div class="category-list">
                {% for cat in categories if categories %}
                <a href="{{ url_for('shops.category_shops', category_id=cat.id) }}" class="sidebar-link">
                    {{ cat.name }}
                </a>
                {% else %}
                <!-- If categories not passed globally, fetching via ajax or they might be in context -->
                <p class="no-cats">ক্যাটেগরি লোড হচ্ছে...</p>
                {% endfor %}
            </div>
        </div>
    </aside>

    <main class="container">
        {% with messages = get_flashed_messages(with_categories=true) %}
        {% if messages %}
        <div class="flash-messages">
            {% for category, message in messages %}
            <div class="flash-message flash-{{ category }}">
                {{ message }}
                <button class="flash-close" onclick="this.parentElement.remove()">×</button>
            </div>
            {% endfor %}
        </div>
        {% endif %}
        {% endwith %}

        {% block content %}{% endblock %}
    </main>

    <footer class="main-footer">
        <div class="container unified-footer-container">
            <!-- Left: Quick Links -->
            <div class="footer-side-column">
                <h4>{{ _('Quick Links') }}</h4>
                <ul class="footer-links">
                    <li><a href="{{ url_for('core.about') }}"><span class="material-icons">chevron_right</span> {{
                            _('About
                            Us') }}</a></li>

                    <li><a href="{{ url_for('shops.shop_list') }}"><span class="material-icons">chevron_right</span> {{
                            _('All
                            Shops') }}</a></li>

                </ul>
            </div>

            <!-- Center: Brand identity -->
            <div class="footer-center-column">
                <div class="footer-logo">
                    <img src="{{ url_for('static', filename='img/logo.svg') }}" alt="BEW Logo">
                    <h4>{{ _('Bangladesh Engineering Workshop') }}</h4>
                </div>
                <p class="footer-desc">{{ _('Your trusted partner for heavy machinery repair, precision machining, and
                    engineering solutions since years.') }}</p>

            </div>

            <!-- Right: Contact Info -->
            <div class="footer-side-column">
                <div class="footer-header-row">
                    <div class="footer-social">
                        <a href="tel:+8801906399161" title="Call Us"><span class="material-icons">phone</span></a>
                        <a href="https://wa.me/8801906399161" title="WhatsApp"><span
                                class="material-icons">chat</span></a>
                    </div>
                    <h4>{{ _('Contact Info') }}</h4>
                </div>
                <ul class="footer-contact-list">
                    <li>
                        <span class="material-icons">phone_android</span>
                        <span>+880 1906 399161</span>
                    </li>
                    <li>
                        <span class="material-icons">email</span>
                        <span>info@bew-bd.com</span>
                    </li>
                    <li>
                        <span class="material-icons">place</span>
                        <span>{{ _('City Bypass, Mostofar Mor, Horintana, Khulna') }}</span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom-bar">
            <div class="container">
                <p class="footer-copyright">&copy; 2026 {{ _('Bangladesh Engineering Workshop') }}. All rights reserved.
                </p>
            </div>
        </div>
    </footer>

    <script src="{{ url_for('static', filename='script.js') }}"></script>
</body>

</html>